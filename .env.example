# Umami Analytics
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id
NEXT_PUBLIC_UMAMI_URL=https://cloud.umami.is/script.js

# Site URL (used for metadata, sitemap, SEO)
NEXT_PUBLIC_SITE_URL=https://intelligenzia.fi

# Comma-separated emails that always get the admin role (bootstraps a fresh database)
ADMIN_EMAILS=hallitus@intelligenzia.fi

# Database. On Netlify, Netlify Database injects NETLIFY_DB_URL and the app
# uses it automatically; migrations in netlify/database/migrations run on deploy.
# DATABASE_URL is only for local development.
# Database - Supabase (legacy, for local development)
# Get your database password from Supabase dashboard
# For production (connection pooler recommended):
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# For local development (direct connection):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase API (get from Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NextAuth (Auth.js v5 also accepts AUTH_URL / AUTH_SECRET)
# Use http://localhost:3000 for local development. Also used as the origin
# for Stripe return URLs and links in emails.
NEXTAUTH_URL=https://intelligenzia.fi
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here

# Email Provider (magic links via Resend)
# Auth uses the next-auth Resend provider; get an API key at https://resend.com/api-keys
# Also sends membership confirmations. The FROM_EMAIL domain must be verified in Resend.
AUTH_RESEND_KEY=re_your-resend-api-key
FROM_EMAIL=Intelligenzia <noreply@intelligenzia.fi>

# Stripe - Payment Integration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-key

# Stripe Webhook Secret
# For local development, use Stripe CLI: stripe listen --forward-to localhost:3000/api/stripe/webhook
# For production, create webhook at https://dashboard.stripe.com/webhooks pointing to https://intelligenzia.fi/api/stripe/webhook
# with these events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_your-secret

# Stripe Product/Price IDs (optional but recommended: without them checkout
# describes the products inline, which works but clutters the Stripe catalogue)
# Full membership - recurring annual subscription (€10/year). Must match FULL_PRICE
# in src/lib/membership.ts. STRIPE_PRICE_ID is accepted as an older alias.
# Create at https://dashboard.stripe.com/products
STRIPE_FULL_MEMBERSHIP_PRICE_ID=price_your-price-id

# Supporting membership - product ID for pay-what-you-want (one-time payments)
# Create a product without a fixed price at https://dashboard.stripe.com/products
STRIPE_SUPPORTING_MEMBERSHIP_PRODUCT_ID=prod_your-product-id
