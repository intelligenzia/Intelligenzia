// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth models
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String             @id @default(cuid())
  name          String?
  email         String?            @unique
  emailVerified DateTime?
  image         String?
  role          UserRole           @default(USER)
  sessions      Session[]
  membership    Membership?
  periods       MembershipPeriod[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

enum UserRole {
  USER
  ADMIN
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Membership models
model Membership {
  id                   String           @id @default(cuid())
  userId               String           @unique
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 MembershipType   @default(FULL)
  status               MembershipStatus @default(PENDING)
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?
  amountPaid           Int? // Amount in cents
  currentPeriodEnd     DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

/// One paid membership year: the history behind the single Membership row.
/// Each row is one Stripe payment (subscription invoice, one-off checkout or
/// a legacy charge), so re-importing is idempotent on stripePaymentId.
model MembershipPeriod {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             MembershipType
  startsAt         DateTime
  endsAt           DateTime
  amountPaid       Int? // Amount in cents
  source           String // invoice | checkout | charge
  stripePaymentId  String         @unique
  stripeCustomerId String?
  createdAt        DateTime       @default(now())

  @@index([userId])
  @@index([startsAt, endsAt])
}

enum MembershipType {
  FULL // Varsinainen jäsen
  SUPPORTING // Kannatusjäsen
}

enum MembershipStatus {
  PENDING // Waiting for board approval
  ACTIVE // Approved and paid
  EXPIRED // Membership period ended
  CANCELLED // User cancelled
}
